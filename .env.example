# Copy this file to .env for local-only machine settings.
# Do not commit your real .env file.

OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
OPENAI_ASSISTANT_MODEL_ECONOMY=
OPENAI_ASSISTANT_MODEL_BALANCED=
OPENAI_ASSISTANT_MODEL_QUALITY=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low
OPENAI_SAFETY_IDENTIFIER=coqpi-local-user
COQPI_PROFILE_DIR=./data/profile
COQPI_SESSIONS_DIR=./data/sessions
COQPI_GOVERNANCE_DIR=./data/governance
# shadow records decisions but does not block; enforce blocks denied/approval-gated future tool routes.
COQPI_GOVERNANCE_MODE=shadow
COQPI_ASSISTANT_PROVIDER_PROFILE=openai:0,ollama:50
COQPI_ASSISTANT_FAILOVER_MODE=ordered
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ASSISTANT_MODEL=llama3.1

# Opportunity discovery. Keep keys backend-only; never paste them into Finder content.
BRAVE_SEARCH_API_KEY=
# Optional JobSpy Python environment; omit to keep the sidecar disabled.
COQPI_JOBSPY_PYTHON=

# Google desktop OAuth client. Gmail and Calendar are approved separately in the UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
